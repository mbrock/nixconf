// ============================================================================
// INPUT CONFIGURATION
// ============================================================================

input {
    keyboard {
        xkb {
            layout "us"
            variant "dvorak"
            options "altwin:swap_alt_win"
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
    }
}

// ============================================================================
// OUTPUT CONFIGURATION
// ============================================================================

output "Virtual-1" {
    scale 1.4
    transform "normal"
}

// ============================================================================
// LAYOUT & APPEARANCE
// ============================================================================

layout {
    gaps 20
    background-color "#1a1510"
    center-focused-column "on-overflow"

    // Column width presets (Mod+R to cycle)
    preset-column-widths {
        proportion 0.25
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    // Focus ring with golden glow
    focus-ring {
        width 3
        active-color "#d4a574"
        inactive-color "#4a3f2f"
    }

    // Window borders with golden gradient
    border {
        width 2
        inactive-color "#2a2319"
        active-gradient from="#daa520" to="#cd853f" angle=135 in="oklch longer hue"
        urgent-color "#ff6347"
    }

    // Elevated drop shadow with warm tint
    shadow {
        softness 40
        spread 8
        offset x=0 y=8
        color "#0000009f"
    }

    // Screen margins
    struts {
        left 0
        right 0
        top 8
        bottom 0
    }
}

// ============================================================================
// GENERAL SETTINGS
// ============================================================================

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/%Y-%m/%H%M%S.png"

animations {
    off
}

// ============================================================================
// WINDOW RULES
// ============================================================================

// Default window appearance
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
    tiled-state true
}

// Special rule for configuration build window
window-rule {
    match title="conf-build"
    open-floating false
    geometry-corner-radius 12
    border {
        width 3
        active-gradient from="#f4a460" to="#daa520" angle=135 in="oklch longer hue"
    }
}

// ============================================================================
// STARTUP & ENVIRONMENT
// ============================================================================

spawn-at-startup "xwayland-satellite"
spawn-at-startup "swaybg" "-i" "/home/mbrock/Pictures/wallpaper.jpg" "-m" "fill"

environment {
    DISPLAY ":0"
}

// ============================================================================
// KEYBINDINGS
// ============================================================================

binds {
    // Help
    Mod+Shift+Slash { show-hotkey-overlay; }

    // ────────────────────────────────────────────────────────────────────────
    // Application Launchers
    // ────────────────────────────────────────────────────────────────────────
    Mod+B      hotkey-overlay-title="Chromium"                    { spawn "chromium"; }
    Mod+T      hotkey-overlay-title="Open a Terminal: kitty"      { spawn "kitty"; }
    Mod+E                                                          { spawn "emacs" "--internal-border=12"; }
    Mod+D      hotkey-overlay-title="Run an Application: fuzzel"  { spawn "fuzzel"; }
    Mod+Return hotkey-overlay-title="Build Config: make in ~/conf" {
        spawn "kitty" "--title=conf-build" "-o" "font_size=18" "-o" "background=#001122" "conf-build";
    }

    // ────────────────────────────────────────────────────────────────────────
    // Window Management
    // ────────────────────────────────────────────────────────────────────────
    Mod+O repeat=false { toggle-overview; }
    Mod+Q              { close-window; }
    Mod+Tab            { focus-window-previous; }

    // ────────────────────────────────────────────────────────────────────────
    // Focus Navigation (Vim-style)
    // ────────────────────────────────────────────────────────────────────────
    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }

    // ────────────────────────────────────────────────────────────────────────
    // Window Movement
    // ────────────────────────────────────────────────────────────────────────
    Mod+Left       { move-column-left; }
    Mod+Down       { move-window-down; }
    Mod+Up         { move-window-up; }
    Mod+Right      { move-column-right; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+L     { move-column-right; }

    // ────────────────────────────────────────────────────────────────────────
    // Workspace Navigation
    // ────────────────────────────────────────────────────────────────────────
    Mod+U       { focus-workspace-down; }
    Mod+I       { focus-workspace-up; }
    Mod+Ctrl+U  { move-column-to-workspace-down; }
    Mod+Ctrl+I  { move-column-to-workspace-up; }
    Mod+Shift+U { move-workspace-down; }
    Mod+Shift+I { move-workspace-up; }

    // Workspace switching (1-9)
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    // Move window to workspace (1-9)
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    // ────────────────────────────────────────────────────────────────────────
    // Column & Window Manipulation
    // ────────────────────────────────────────────────────────────────────────
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma        { consume-window-into-column; }
    Mod+Period       { expel-window-from-column; }

    // ────────────────────────────────────────────────────────────────────────
    // Resizing & Layout
    // ────────────────────────────────────────────────────────────────────────
    Mod+R       { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R  { reset-window-height; }
    Mod+F       { maximize-column; }
    Mod+Shift+F { toggle-windowed-fullscreen; }
    Mod+Ctrl+F  { expand-column-to-available-width; }
    Mod+C       { center-column; }
    Mod+Ctrl+C  { center-visible-columns; }
    Mod+W       { toggle-column-tabbed-display; }

    // Fine-grained width adjustments
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    // Fine-grained height adjustments
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // ────────────────────────────────────────────────────────────────────────
    // Floating Windows
    // ────────────────────────────────────────────────────────────────────────
    Mod+V { toggle-window-floating; }

    // ────────────────────────────────────────────────────────────────────────
    // Clipboard Integration (macOS host)
    // ────────────────────────────────────────────────────────────────────────
    Mod+Shift+C hotkey-overlay-title="Copy to macOS clipboard"   { spawn "copy-to-mac"; }
    Mod+Shift+V hotkey-overlay-title="Paste from macOS clipboard" { spawn "paste-from-mac"; }

    // ────────────────────────────────────────────────────────────────────────
    // Screenshots
    // ────────────────────────────────────────────────────────────────────────
    Print      { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print  { screenshot-window; }

    // ────────────────────────────────────────────────────────────────────────
    // System Controls
    // ────────────────────────────────────────────────────────────────────────
    Mod+Ctrl+Shift+R hotkey-overlay-title="Reload niri config" { spawn "sh" "-c" "niri msg reload-config"; }
    Mod+Escape allow-inhibiting=false                           { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+E                                                 { quit; }
    Ctrl+Alt+Delete                                             { quit; }
    Mod+Shift+P                                                 { power-off-monitors; }
}
